{
  "name": "ns-online-trading",
  "version": "1.0.0",
  "description": "NationStates Online Stock & Commodity Trading Simulation",
  "scripts": {
    "start": "node server/index.js",
    "start:local": "node -e \"process.env.USE_LOCAL_DB='true'; require('./server/index.js');\"",
    "start:cloud": "node -e \"process.env.USE_LOCAL_DB='false'; require('./server/index.js');\"",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build && cd ../server && npm install",
    "build:client": "cd client && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "nationstates",
    "trading",
    "stock-market",
    "simulation"
  ],
  "author": "",
  "license": "ISC"
}
